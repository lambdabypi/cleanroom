# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# --- You.com (required: the live-web observation layer) --------------------
# https://you.com/platform -> API Keys -> Create Key
YOU_API_KEY=
# Docs say https://ydc-index.io/v1 ; the hackathon PDF uses https://api.ydc-index.io/v1.
# Both have been seen in the wild, so the client probes and falls back. Override
# here to pin one explicitly.
YOU_API_BASE=https://ydc-index.io/v1

# --- The code writer (required: something must write the extractor) -------
# Pick ONE of the three options below.
#
# COST WARNING, measured on the You.com billing dashboard:
#   Web Search API      $5 per 1000 calls   = $0.005/call   <- negligible
#   Agent API Advanced  $15 PER CALL        = $300+ per run <- do not use in a loop
# Retrieval on You.com is effectively free; code generation on You.com is not.
# `CLEANROOM_SYNTH_BACKEND=auto` will therefore never pick the Agents API.

# Option 1 (recommended, free tiers). Any OpenAI-compatible /chat/completions
# endpoint. Provider-native key names are auto-detected, so just pasting
# GROQ_API_KEY=... (or CEREBRAS_/GEMINI_/OPENROUTER_/TOGETHER_/DEEPSEEK_) is enough
# and the base URL + a sensible model are filled in for you.
#
# Hosted model catalogues churn -- a name that worked last month 404s today.
# Run `cleanroom models` to list what your key can actually reach.
#   Groq       https://api.groq.com/openai/v1                          openai/gpt-oss-120b
#   Cerebras   https://api.cerebras.ai/v1                              llama-3.3-70b
#   Gemini     https://generativelanguage.googleapis.com/v1beta/openai gemini-2.5-flash
#   OpenRouter https://openrouter.ai/api/v1                            <any ...:free model>
#   Ollama     http://localhost:11434/v1                               qwen2.5-coder:7b  (no key)
GROQ_API_KEY=
# Only needed to override the auto-detected defaults:
CLEANROOM_LLM_BASE_URL=
CLEANROOM_LLM_API_KEY=
CLEANROOM_LLM_MODEL=

# Option 2: Anthropic (paid, but the most reliable and the fastest per call).
ANTHROPIC_API_KEY=
CLEANROOM_MODEL=claude-opus-5

# Option 3: You.com Agents API. $15/call -- opt in deliberately or not at all.
# CLEANROOM_SYNTH_BACKEND=you
# YOU_AGENT_MAX_CALLS=3
CLEANROOM_SYNTH_BACKEND=auto

# --- Daytona (required: the sandbox that produces the reward signal) ------
# https://app.daytona.io -> Billing -> redeem DAYTONA_HACKATHON_NYC_PF5W2GVE
DAYTONA_API_KEY=
# Sandboxes auto-stop after this many idle minutes. Keep it low; orphaned
# sandboxes burn the coupon.
DAYTONA_AUTO_STOP_MINUTES=15

# --- One (required: credential layer, memory store, and the write-back) ---
# https://app.withone.ai/settings/api-keys ; coupon YOU-NYC-PRO
ONE_SECRET=
ONE_CONNECTION_KEYS=
# Where the agent publishes the cleaned dataset. This is the "changed something
# in a real system" half of the loop -- don't leave it unset for the demo.
ONE_PUBLISH_PLATFORM=github
ONE_PUBLISH_TARGET=your-org/your-repo

# --- CrewAI ---------------------------------------------------------------
# CrewAI 1.15 asks an interactive "view your execution traces?" question on first
# use, with a 20s timeout -- which stalls a scripted run and blocks a fresh clone.
# The code sets these before importing crewai; set TRACING to true if you want it.
CREWAI_TRACING_ENABLED=false
CREWAI_TELEMETRY_OPT_OUT=true

# --- Local behaviour ------------------------------------------------------
CLEANROOM_STATE_DIR=state
# Set to 1 to skip Daytona and validate in-process. Much faster while you are
# iterating on prompts; the demo should run with this at 0.
CLEANROOM_LOCAL_VALIDATE=0
